<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Mobile_Number_Length</fullName>
    <active>true</active>
    <errorConditionFormula>LEN( Mobile__c )  &lt;&gt; 10</errorConditionFormula>
    <errorDisplayField>Mobile__c</errorDisplayField>
    <errorMessage>Mobile number must contain exactly 10 digits.</errorMessage>
</ValidationRule>
