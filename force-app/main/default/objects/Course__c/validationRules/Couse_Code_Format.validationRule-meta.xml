<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Couse_Code_Format</fullName>
    <active>true</active>
    <errorConditionFormula>NOT( REGEX( Name , &quot;[A-Z]{2}[0-9]{3}&quot;) )</errorConditionFormula>
    <errorDisplayField>Name</errorDisplayField>
    <errorMessage>Course Code must be in the format AA999 (Example: CS101).</errorMessage>
</ValidationRule>
