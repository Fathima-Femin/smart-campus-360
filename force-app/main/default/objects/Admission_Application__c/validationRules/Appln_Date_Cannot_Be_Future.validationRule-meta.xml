<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Appln_Date_Cannot_Be_Future</fullName>
    <active>true</active>
    <errorConditionFormula>Application_Date__c  &gt;  NOW()</errorConditionFormula>
    <errorDisplayField>Application_Date__c</errorDisplayField>
    <errorMessage>Application Date cannot be in the future.</errorMessage>
</ValidationRule>
